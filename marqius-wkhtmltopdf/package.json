{
  "name": "marqius-wkhtmltopdf",
  "version": "0.12.13",
  "description": "The maintained drop-in replacement for wkhtmltopdf, for Node's wkhtmltopdf and wkhtmltoimage packages. Prints Arabic, Hebrew, Hindi, Thai, Chinese, Japanese and Korean. Commercial, 30-day trial, free Community licence available.",
  "keywords": [
    "wkhtmltopdf",
    "wkhtmltoimage",
    "pdf",
    "html-to-pdf",
    "html2pdf",
    "pdf-generation",
    "html-to-image",
    "invoice",
    "rtl",
    "arabic",
    "hebrew",
    "hindi",
    "thai",
    "chinese",
    "japanese",
    "korean",
    "cjk",
    "unicode"
  ],
  "homepage": "https://marqius.com/wkhtmltopdf/",
  "bugs": {
    "url": "https://github.com/marqiushq/marqius-wkhtmltopdf-node/issues",
    "email": "hello@marqius.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marqiushq/marqius-wkhtmltopdf-node.git",
    "directory": "marqius-wkhtmltopdf"
  },
  "license": "SEE LICENSE IN LICENSE.md",
  "author": "Simple AI LLC <hello@marqius.com> (https://marqius.com)",
  "main": "index.js",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "require": "./index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "marqius-wkhtmltopdf": "bin/marqius-wkhtmltopdf.js"
  },
  "files": [
    "index.js",
    "index.mjs",
    "index.d.ts",
    "bin/marqius-wkhtmltopdf.js",
    "LICENSE.md"
  ],
  "engines": {
    "node": ">=14"
  },
  "optionalDependencies": {
    "marqius-wkhtmltopdf-darwin-arm64": "0.12.13",
    "marqius-wkhtmltopdf-linux-arm64": "0.12.13",
    "marqius-wkhtmltopdf-linux-x64": "0.12.13",
    "marqius-wkhtmltopdf-win32-x64": "0.12.13"
  }
}
